# v5: user FLASH W25Q64 on general IO (sch: CS=P8 SCLK=M9 SDO=N8 FPGA->flash SDI=P7 flash->FPGA WP=P9 HOLD=R9)
set_pin_assignment	c_flash_cs	{ LOCATION = P8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	c_flash_sck	{ LOCATION = M9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# v5b: P7/N8 direction SWAP after board evidence (erase WIP poll read stuck-FF = MISO dead).
# Schematic net names (SDO/SDI) are FLASH-side view: flash SDO(=out)->FPGA P7 must be MISO.
set_pin_assignment	c_flash_mosi	{ LOCATION = P7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	c_flash_miso	{ LOCATION = N8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
